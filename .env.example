# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=sutra
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=sutra_db
DATABASE_URL=postgresql://sutra:change_this_password@db:5432/sutra_db

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
SESSION_SECRET=change_this_to_a_random_64_char_string_before_deploying_to_production

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Sutra Collections
NEXT_PUBLIC_APP_VERSION=0.1.0

# ─── Business Config ─────────────────────────────────────────────────────────
# Your GST Number (filled in Phase 3 - Billing)
# GSTIN=

# Your UPI VPA for invoice QR codes (filled in Phase 6 - Payments)
# UPI_VPA=

# ─── WhatsApp Cloud API (filled in Phase 7) ──────────────────────────────────
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_TOKEN=your_verify_token_here
# Meta-approved template names (must match exactly)
# WHATSAPP_INVOICE_TEMPLATE=sutra_invoice_notification
# WHATSAPP_REMINDER_TEMPLATE=sutra_payment_reminder

# ─── Gemini API (filled in Phase 9 - AI Import) ──────────────────────────────
# GEMINI_API_KEY=


# ─── Anthropic Claude API (AI Import for purchases) ──────────────────────────
# ANTHROPIC_API_KEY=
