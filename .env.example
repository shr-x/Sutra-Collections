# ─── Database ────────────────────────────────────────────────────────────────
# All three must be consistent with each other
POSTGRES_USER=sutra
POSTGRES_PASSWORD=CHANGE_THIS_strong_password_here
POSTGRES_DB=sutra_db
DATABASE_URL=postgresql://sutra:CHANGE_THIS_strong_password_here@db:5432/sutra_db

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
SESSION_SECRET=CHANGE_THIS_to_a_random_64_char_string

# Separate secret for the super-admin console (/sa-console-x7k2)
# Generate with: openssl rand -base64 64
SA_SESSION_SECRET=CHANGE_THIS_to_a_different_64_char_string

# ─── Cron ────────────────────────────────────────────────────────────────────
# Passed as x-cron-secret header when calling POST /api/cron/daily
# Generate with: openssl rand -hex 32
CRON_SECRET=CHANGE_THIS_hex_string

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Set to true ONLY after SSL/HTTPS is fully configured (certbot or Cloudflare).
# On plain HTTP this must be false — browsers drop secure cookies over HTTP.
COOKIE_SECURE=false
NEXT_PUBLIC_APP_NAME=Sutra Collections
NEXT_PUBLIC_APP_VERSION=1.0.0

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Get from Meta Business Manager → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
# Set when configuring the webhook URL in Meta Business Manager
WHATSAPP_WEBHOOK_TOKEN=your_webhook_verify_token

# ─── Gemini API (AI-powered data import — optional) ──────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Business Config (set in app Settings after first login) ─────────────────
# GSTIN=                  # Your GST Number
# UPI_VPA=                # Your UPI VPA for invoice QR codes
